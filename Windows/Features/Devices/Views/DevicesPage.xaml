<Page
    x:Class="LIAF.Windows.Features.Devices.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="24" Padding="24" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Devices" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Connected ADB and Fastboot devices" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
            </Grid>

            <InfoBar
                IsOpen="{Binding HasError, Mode=OneWay}"
                Severity="Error"
                Title="Device operation failed"
                Message="{Binding ErrorMessage}" />

            <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="Connected devices" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ProgressRing IsActive="{Binding IsLoading}" Width="28" Height="28" HorizontalAlignment="Right" />
                    </Grid>

                    <ListView ItemsSource="{Binding Devices}" SelectionMode="None">
                        <ListView.Header>
                            <Grid Padding="12" ColumnSpacing="16" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Serial" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="State" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Type" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Name" FontWeight="SemiBold" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SerialNumber}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding State}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Type}" />
                                    <TextBlock Grid.Column="3" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="ADB command console" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Enter arguments only; the configured adb executable is prepended automatically." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBox
                        Header="Arguments passed to adb"
                        Text="{Binding CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="devices -l" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Run adb" Command="{Binding RunAdbCommandCommand}" />
                        <TextBlock Text="{Binding CommandStatus}" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <InfoBar
                        IsOpen="{Binding HasCommandError, Mode=OneWay}"
                        Severity="Error"
                        Title="ADB command failed"
                        Message="{Binding CommandError}" />

                    <TextBox
                        Header="Output"
                        Text="{Binding CommandOutput, Mode=OneWay}"
                        AcceptsReturn="True"
                        IsReadOnly="True"
                        FontFamily="Consolas"
                        TextWrapping="NoWrap"
                        MinHeight="220" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
