<Page
    x:Class="LIAF.Windows.Features.Settings.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="18" Padding="24" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Configure Android platform tool executable paths." Style="{ThemeResource BodyTextBlockStyle}" />
            </StackPanel>

            <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="14">
                    <TextBox
                        Header="ADB executable path"
                        Text="{Binding AdbExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="adb" />
                    <TextBox
                        Header="Fastboot executable path"
                        Text="{Binding FastbootExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="fastboot" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save" Command="{Binding SaveCommand}" />
                        <Button Content="Reset defaults" Command="{Binding ResetCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
